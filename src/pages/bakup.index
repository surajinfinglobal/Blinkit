def rep(old, new, count=1):
    global s
    assert old in s, f"missing: {old[:60]!r}"
    s = s.replace(old, new, count)

# 1) module-level helpers + AddressField
rep('/* ================= PRODUCT UI COMPONENTS ================= */', '''/* ================= ADDRESS FORM HELPERS ================= */

const EMPTY_ADDRESS_FORM = {
  house: "",      // House / Flat no.      (required)
  apartment: "",  // Apartment / Society   (optional)
  area: "",       // Area / Street         (required)
  landmark: "",   // Landmark              (optional)
  city: "",       // City                  (required)
  pincode: "",    // Pincode               (required)
};

// Alag fields se ek readable `line` banata hai (header, checkout wagairah isi `line` ko dikhate hain)
const composeAddressLine = (f) =>
  [f.house, f.apartment, f.area, f.landmark && `Near ${f.landmark}`, f.city]
    .map((x) => (x || "").trim())
    .filter(Boolean)
    .join(", ");

/*
  👉 YAHAN apni API call lagao.
  Jab tak ye promise resolve nahi hota, Save button loading state mein rahega.
  Fail hone par `throw new Error("...")` karo, wo form ke neeche red text mein dikhega.

  Example:
    const res = await fetch("/api/addresses", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(address),
    });
    if (!res.ok) throw new Error("Address save nahi ho paya");
    return await res.json();   // server se id/extra fields aayein to unhe return karo
*/
const saveAddressToServer = async (address) => {
  await new Promise((r) => setTimeout(r, 900)); // dummy delay – API lagate hi hata dena
  return address;
};

const AddressField = ({ label, required, error, children }) => (
  <label className="block">
    <span className="mb-1 flex items-center gap-1 text-[11px] font-semibold text-gray-600">
      {label}
      {required ? (
        <span className="text-red-500">*</span>
      ) : (
        <span className="font-normal text-gray-400">(optional)</span>
      )}
    </span>
    {children}
    {error && (
      <span role="alert" className="mt-1 block text-[10px] text-red-500">
        {error}
      </span>
    )}
  </label>
);

/* ================= PRODUCT UI COMPONENTS ================= */''')

# 2) state
rep('''  const [newLine, setNewLine] = useState("");
  const [newPincode, setNewPincode] = useState("");
  const [formError, setFormError] = useState("");''', '''  const [form, setForm] = useState(EMPTY_ADDRESS_FORM);
  const [fieldErrors, setFieldErrors] = useState({});
  const [formError, setFormError] = useState(""); // API / general error
  const [saving, setSaving] = useState(false);    // true => Save button loading''')

# 3) open/close sheet
rep('''    setLocError("");
    setFormError("");
    setShowSheet(true);
  };
  const closeSheet = () => {
    if (locating) return;''', '''    setLocError("");
    setFormError("");
    setFieldErrors({});
    setShowSheet(true);
  };
  const closeSheet = () => {
    if (locating || saving) return; // save chal raha ho to sheet band nahi hogi''')

# 4) saveNewAddress
a = s.index("  const saveNewAddress = () => {")
b = s.index("  // ---- Star renderer ----")
s = s[:a] + '''  const updateField = (key, value) => {
    setForm((prev) => ({ ...prev, [key]: value }));
    setFieldErrors((prev) => (prev[key] ? { ...prev, [key]: "" } : prev));
    setFormError("");
  };

  const saveNewAddress = async () => {
    if (saving) return;

    // ---- Validation ----
    const errs = {};
    if (!form.house.trim()) errs.house = "House / Flat no. daalo";
    if (form.area.trim().length < 3) errs.area = "Area / Street daalo";
    if (form.city.trim().length < 2) errs.city = "City daalo";
    if (!/^\\d{6}$/.test(form.pincode)) errs.pincode = "6-digit valid pincode daalo";
    setFieldErrors(errs);
    if (Object.keys(errs).length) return;

    const addr = {
      id: `a${Date.now()}`,
      label: newLabel,
      house: form.house.trim(),
      apartment: form.apartment.trim(),
      area: form.area.trim(),
      landmark: form.landmark.trim(),
      city: form.city.trim(),
      pincode: form.pincode,
      line: composeAddressLine(form), // purane code (header/checkout) ke liye
    };

    try {
      setSaving(true); // 👈 loading ON (API call shuru)
      setFormError("");
      const saved = (await saveAddressToServer(addr)) || {};
      const finalAddr = { ...addr, ...saved }; // server ka id/extra data merge

      setAddresses((prev) => [...prev, finalAddr]);
      setSelectedId(finalAddr.id);
      setForm(EMPTY_ADDRESS_FORM);
      setFieldErrors({});
      setNewLabel("Home");
      setShowSheet(false);
    } catch (err) {
      setFormError(err?.message || "Address save nahi ho paya. Dobara try karo.");
    } finally {
      setSaving(false); // 👈 loading OFF
    }
  };

''' + s[b:]

# 5) back button guard
rep('''                        onClick={() => {
                          setSheetView("list");
                          setFormError("");
                        }}
                        aria-label="Back"''', '''                        disabled={saving}
                        onClick={() => {
                          setSheetView("list");
                          setFormError("");
                          setFieldErrors({});
                        }}
                        aria-label="Back"''')

# 6) ADD VIEW jsx
start_marker = "                {/* ---------- ADD VIEW ---------- */}"
end_marker = "\n              </div>\n            </div>,\n            document.body"
a = s.index(start_marker)
b = s.index(end_marker)
new_view = '''                {/* ---------- ADD VIEW ---------- */}
                {sheetView === "add" && (
                  <fieldset disabled={saving} className="m-0 min-w-0 space-y-3 border-0 p-0">
                    {/* Label chips */}
                    <div className="flex gap-2">
                      {["Home", "Work", "Other"].map((l) => (
                        <button
                          key={l}
                          type="button"
                          onClick={() => setNewLabel(l)}
                          className={`flex items-center gap-1 px-3 py-1.5 rounded-full text-[12px] font-semibold border transition disabled:opacity-60 ${
                            newLabel === l
                              ? "bg-[#F8CB46] border-[#F8CB46] text-black"
                              : "bg-white border-gray-200 text-gray-500"
                          }`}
                        >
                          <span className="material-symbols-outlined text-[16px]">{LABEL_ICONS[l]}</span>
                          {l}
                        </button>
                      ))}
                    </div>

                    <AddressField label="House / Flat no." required error={fieldErrors.house}>
                      <input
                        type="text"
                        value={form.house}
                        onChange={(e) => updateField("house", e.target.value)}
                        placeholder="e.g. D-96, Flat 402"
                        autoComplete="address-line1"
                        className={`${inputCls} ${fieldErrors.house ? "!border-red-400" : ""}`}
                      />
                    </AddressField>

                    <AddressField label="Apartment / Society">
                      <input
                        type="text"
                        value={form.apartment}
                        onChange={(e) => updateField("apartment", e.target.value)}
                        placeholder="e.g. Shree Residency"
                        autoComplete="address-line2"
                        className={inputCls}
                      />
                    </AddressField>

                    <AddressField label="Area / Street" required error={fieldErrors.area}>
                      <input
                        type="text"
                        value={form.area}
                        onChange={(e) => updateField("area", e.target.value)}
                        placeholder="e.g. Kamla Nagar"
                        autoComplete="address-level3"
                        className={`${inputCls} ${fieldErrors.area ? "!border-red-400" : ""}`}
                      />
                    </AddressField>

                    <AddressField label="Landmark">
                      <input
                        type="text"
                        value={form.landmark}
                        onChange={(e) => updateField("landmark", e.target.value)}
                        placeholder="e.g. Near North Campus"
                        className={inputCls}
                      />
                    </AddressField>

                    <div className="grid grid-cols-2 gap-3">
                      <AddressField label="City" required error={fieldErrors.city}>
                        <input
                          type="text"
                          value={form.city}
                          onChange={(e) => updateField("city", e.target.value)}
                          placeholder="e.g. New Delhi"
                          autoComplete="address-level2"
                          className={`${inputCls} ${fieldErrors.city ? "!border-red-400" : ""}`}
                        />
                      </AddressField>
                      <AddressField label="Pincode" required error={fieldErrors.pincode}>
                        <input
                          type="text"
                          inputMode="numeric"
                          maxLength={6}
                          value={form.pincode}
                          onChange={(e) => updateField("pincode", e.target.value.replace(/\\D/g, ""))}
                          placeholder="110007"
                          autoComplete="postal-code"
                          className={`${inputCls} ${fieldErrors.pincode ? "!border-red-400" : ""}`}
                        />
                      </AddressField>
                    </div>

                    {formError && (
                      <p role="alert" className="text-[11px] text-red-500">
                        {formError}
                      </p>
                    )}

                    <button
                      type="button"
                      onClick={saveNewAddress}
                      disabled={saving}
                      aria-busy={saving}
                      className="flex w-full items-center justify-center gap-2 rounded-xl bg-[#F8CB46] py-3.5 text-[13px] font-bold tracking-wider text-black transition active:scale-[0.99] disabled:opacity-70"
                    >
                      {saving ? (
                        <>
                          <span className="h-4 w-4 animate-spin rounded-full border-2 border-black/20 border-t-black" />
                          SAVING ADDRESS...
                        </>
                      ) : (
                        <>SAVE &amp; USE THIS ADDRESS</>
                      )}
                    </button>
                  </fieldset>
                )}'''
s = s[:a] + new_view + s[b:]

open(p, "w", encoding="utf-8").write(s)
print("ok")
